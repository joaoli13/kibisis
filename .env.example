# Optional for static-only UI mode. Required for full pipeline/API mode.
# Any Postgres-compatible database with pgvector and pg_trgm works, including Neon.
DATABASE_URL=
# Optional Vercel Postgres/Neon integration alias. Used if DATABASE_URL is absent.
POSTGRES_URL=

# Optional direct database URL for migrations/restores.
# Vercel's Neon integration can provide DATABASE_URL_UNPOOLED.
DATABASE_URL_UNPOOLED=

# Required for M3 embeddings and /api/synthesize.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_THINKING_BUDGET=0

# UI locale used for / redirects.
NEXT_PUBLIC_DEFAULT_LOCALE=pt
